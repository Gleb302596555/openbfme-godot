extends SceneTree
func _initialize():call_deferred('_run')
func _run():
 var install=OS.get_environment('BFME1_INSTALL')
 if install.is_empty():print('BFME1 MAP LIBRARY SKIP: set BFME1_INSTALL');quit(77);return
 var fs=ClassDB.instantiate('RetailFileSystem')
 assert(fs.mount_bfme1_path(install).ok)
 var folder='/tmp/openbfme-bfme1-library-'+str(OS.get_process_id())+'-'+str(Time.get_ticks_usec())
 assert(DirAccess.make_dir_recursive_absolute(folder)==OK)
 var source=folder.path_join('source')
 assert(DirAccess.make_dir_recursive_absolute(source)==OK)
 var path=source.path_join('Library fixture.map')
 var file=FileAccess.open(path,FileAccess.WRITE)
 file.store_buffer(fs.read_file('maps/map mp fords of isen/map mp fords of isen.map'));file.close()
 var inspected=fs.inspect_library_map(path,false)
 assert(inspected.ok,str(inspected))
 assert(inspected.players==2)
 var destination=folder.path_join('installed')
 var imported=fs.install_library_map(path,destination)
 assert(imported.ok,str(imported))
 assert(fs.installed_maps(destination).size()==1)
 # A companion-only update must install new bytes even with unchanged .map bytes.
 var ini=FileAccess.open(source.path_join('map.ini'),FileAccess.WRITE)
 ini.store_string('; companion revision one');ini.close()
 var updated=fs.install_library_map(path,destination)
 assert(updated.ok,str(updated))
 assert(updated.content_id!=imported.content_id)
 assert(fs.read_file(str(updated.key).get_base_dir().path_join('map.ini')).get_string_from_utf8()=='; companion revision one')
 ini=FileAccess.open(source.path_join('map.ini'),FileAccess.WRITE)
 ini.store_string('; companion revision two');ini.close()
 var latest=fs.install_library_map(path,destination)
 assert(latest.ok,str(latest))
 assert(latest.content_id!=updated.content_id)
 assert(fs.read_file(str(latest.key).get_base_dir().path_join('map.ini')).get_string_from_utf8()=='; companion revision two')
 assert(fs.install_library_map(path,destination).content_id==latest.content_id)
 assert(fs.installed_maps(destination).size()==3)

 assert(fs.mount_bfme1_path(install).ok)
 var remounted=fs.installed_maps(destination)
 assert(remounted.size()==3)
 assert(not fs.read_file(remounted[0].key).is_empty(),'Remount must rebuild imported map aliases')
 var fresh=ClassDB.instantiate('RetailFileSystem')
 assert(fresh.mount_bfme1_path(install).ok)
 var installed=fresh.installed_maps(destination)
 assert(installed.size()==3,'BFME1 imports must reload after restarting')
 assert(installed[0].installed and not installed[0].library)
 assert(not fresh.read_file(installed[0].key).is_empty())
 print('BFME1 MAP LIBRARY PASS')
 quit(0)
