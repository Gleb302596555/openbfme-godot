## Metadata must use this map's overrides without inheriting a preview's world.
extends SceneTree
func _initialize() -> void: call_deferred("_run")
func _run() -> void:
	var install := OS.get_environment("BFME1_INSTALL")
	if install.is_empty(): quit(77); return
	create_timer(120).timeout.connect(func(): push_error("BFME1 map scan timed out"); quit(1))
	var fs = ClassDB.instantiate("RetailFileSystem")
	assert(fs.mount_bfme1_path(install).ok)
	var scanner = ClassDB.instantiate("MapObjectBuilder")
	var retail := "map mp fords of isen"
	var baseline: Dictionary = scanner.scan_definition(fs,retail)
	assert(baseline.ok,str(baseline))
	var initial_preview = scanner.build_objects(fs,retail,{"max_objects":1,"animations":false,"skybox":false})
	assert(initial_preview!=null,str(scanner.get_report()))
	root.add_child(initial_preview)
	var placed: Dictionary = scanner.get_report().objects.by_template_top
	assert(not placed.is_empty())
	var changed_template: String = placed.keys()[0]
	initial_preview.queue_free()
	var directory := OS.get_temp_dir().path_join("bfme1-scan-"+str(OS.get_process_id()))
	assert(DirAccess.make_dir_recursive_absolute(directory)==OK)
	var path := directory.path_join("fixture.map")
	var file := FileAccess.open(path,FileAccess.WRITE)
	file.store_buffer(fs.read_file("maps/"+retail+"/"+retail+".map"));file.close()
	file = FileAccess.open(directory.path_join("map.ini"),FileAccess.WRITE)
	file.store_string("Object "+changed_template+"\n KindOf = STRUCTURE CAPTURABLE\nEnd\n");file.close()
	var imported: Dictionary = fs.inspect_library_map(path,true)
	assert(imported.ok,str(imported))
	var deferred: Dictionary = scanner.scan_definition(fs,imported.preview_name,{"map_ini":false})
	assert(deferred.get("needs_map_ini",false),str(deferred))
	var overridden: Dictionary = scanner.scan_definition(fs,imported.preview_name)
	assert(overridden.ok,str(overridden))
	assert(not overridden.capturables.is_empty(),str(overridden))
	assert(overridden.capturables.all(func(b): return b.template == changed_template),str(overridden))
	assert(overridden.capture_flags.is_empty(),str(overridden))
	# A preview applies overrides to its own world before metadata scans reuse the builder.
	var preview = scanner.build_objects(fs,imported.preview_name,{"max_objects":1,"animations":false,"skybox":false,"map_ini":"objects"})
	assert(preview!=null,str(scanner.get_report()))
	root.add_child(preview)
	var clean: Dictionary = scanner.scan_definition(fs,retail,{"map_ini":false})
	assert(clean.ok,str(clean))
	assert(clean.capturables==baseline.capturables)
	assert(clean.capture_flags==baseline.capture_flags)
	var repeated: Dictionary = scanner.scan_definition(fs,imported.preview_name)
	assert(repeated.ok,str(repeated))
	assert(repeated.capturables==overridden.capturables)
	assert(repeated.capture_flags==overridden.capture_flags)
	preview.queue_free()
	print("BFME1 MAP SCAN PASS")
	quit()
